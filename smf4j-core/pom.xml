<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yubrajsahoo</groupId>
    <artifactId>smf4j-core</artifactId>
    <version>0.0.1</version>

    <name>smf4j-core</name>
    <description>Core module of SMF4J - Simple Metrics Facade for Java</description>
    <url>https://github.com/yubrajsahoo/smf4j</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Yubraj Sahoo</name>
            <url>https://github.com/yubrajsahoo</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/yubrajsahoo/smf4j.git</connection>
        <developerConnection>scm:git:ssh://github.com:yubrajsahoo/smf4j.git</developerConnection>
        <url>https://github.com/yubrajsahoo/smf4j</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/yubrajsahoo/smf4j/issues</url>
    </issueManagement>

    <properties>
        <java.version>17</java.version>

        <!-- Security overrides -->
        <assertj.version>3.27.7</assertj.version>
        <logback.version>1.5.19</logback.version>
        <jackson.version>2.21.4</jackson.version>
    </properties>

    <dependencies>

        <!-- Spring Boot Auto Configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Spring Expression Language -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-expression</artifactId>
        </dependency>

        <!-- Spring Context / AOP infrastructure -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Explicit patched AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- Micrometer -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Logging API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Jackson - tests only -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>

        <!--        Test related dependency                 -->

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>